{
  "title": "Swap Engine",
  "uid": "swap-engine",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Failure ratio (10m)",
      "targets": [
        {
          "expr": "sum(rate(swap_orders_total{event=\"failed\"}[10m])) / clamp_min(sum(rate(swap_orders_total{event=~\"created|failed|rejected\"}[10m])), 1e-12)",
          "legendFormat": "failed"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit" } },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "graphMode": "area",
        "colorMode": "background",
        "justifyMode": "center",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Rejection ratio (10m)",
      "targets": [
        {
          "expr": "sum(rate(swap_orders_total{event=\"rejected\"}[10m])) / clamp_min(sum(rate(swap_orders_total{event=~\"created|failed|rejected\"}[10m])), 1e-12)",
          "legendFormat": "rejected"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit" } },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "graphMode": "area",
        "colorMode": "background",
        "justifyMode": "center",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Hand-offs in flight",
      "targets": [
        {
          "expr": "sum(swap_orders_in_flight)",
          "legendFormat": "in flight"
        }
      ],
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "graphMode": "area",
        "colorMode": "background",
        "justifyMode": "center",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Settlement P95 (10m)",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(swap_stage_latency_ms_bucket{stage=\"settle\"}[10m])))",
          "legendFormat": "settle p95"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" } },
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "graphMode": "area",
        "colorMode": "background",
        "justifyMode": "center",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Order lifecycle events per second",
      "targets": [
        {
          "expr": "sum by (event) (rate(swap_orders_total[5m]))",
          "legendFormat": "{{event}}"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Orders by engine per second",
      "targets": [
        {
          "expr": "sum by (engine) (rate(swap_orders_total{event=\"created\"}[5m]))",
          "legendFormat": "{{engine}}"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Stage latency P95 by stage",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, stage) (rate(swap_stage_latency_ms_bucket[5m])))",
          "legendFormat": "{{stage}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Hand-off latency P95 by outcome",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, outcome) (rate(swap_stage_latency_ms_bucket{stage=\"handoff\"}[5m])))",
          "legendFormat": "{{outcome}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Hand-offs in flight",
      "targets": [
        {
          "expr": "sum(swap_orders_in_flight)",
          "legendFormat": "in flight"
        }
      ],
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 22 }
    }
  ]
}

# Development environment profile
# Loaded automatically when APP_ENV=development (the default)
# Values here are overridden by any variable already set in the shell or .env

APP_ENV=development

# Verbose logging for local debugging
RUST_LOG=debug
LOG_FORMAT=text

# Relaxed rate limits — won't throttle local testing
DEFAULT_RATE_LIMIT=10000
WHITELIST_RATE_LIMIT=100000

# Longer DB timeouts to accommodate slow local machines / breakpoints
DB_TIMEOUT_READ_SECS=30
DB_TIMEOUT_WRITE_SECS=60
DB_STATEMENT_TIMEOUT_MS=60000

# Local service URLs
# Restricted, non-superuser role — see scripts/db-init/01-create-app-role.sql.
# Provisioned automatically the first time `docker compose up` initializes
# the postgres volume; run `docker compose down -v && docker compose up` if
# an existing local volume predates this role.
DATABASE_URL=postgres://synapse_app:synapse_app@localhost:5432/synapse
# pg_dump refuses to dump FORCE ROW LEVEL SECURITY tables under synapse_app's
# NOBYPASSRLS role — see Config::backup_database_url.
BACKUP_DATABASE_URL=postgres://synapse:synapse@localhost:5432/synapse
REDIS_URL=redis://localhost:6379
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org

# Placeholder secrets — replace with real values if testing Vault integration
ANCHOR_WEBHOOK_SECRET=dev-webhook-secret
ADMIN_API_KEY=dev-admin-key

# Swap engine rollout gate (see docs/swap-rollout.md). Dev admits every tenant;
# new hand-offs still require the per-tenant `swap_engine` feature flag.
SWAP_ENGINE_ENABLED=true
SWAP_ENGINE_TENANT_ALLOWLIST=*

# Pepper for hashing tenant API keys / passphrase for encrypting tenant
# webhook secrets at rest (see src/db/queries.rs::tenant_secret_key). Must be
# a strong random value outside of local development.
TENANT_SECRET_KEY=dev-only-tenant-secret

# Phase 2 swap engine — all optional; these are the defaults (see src/config.rs::SwapConfig)
SWAP_ENGINE_ENABLED=false
SWAP_MAX_ORDER_AMOUNT=10000
SWAP_FEE_BPS=0
SWAP_QUOTE_TTL_SECONDS=30

# ---------------------------------------------------------------------------
# Swap engine local development profile
# ---------------------------------------------------------------------------
# Placeholder values only — never put real secrets or credentials here.

# Fee strategy: caps and percentiles used when quoting swap fees locally.
# Kept low so seeded demo orders exercise the cap logic deterministically.
SWAP_FEE_MIN_BPS=5
SWAP_FEE_MAX_BPS=100
SWAP_FEE_DEFAULT_BPS=30
SWAP_FEE_PERCENTILE=50
SWAP_FEE_PERCENTILE_WINDOW_SECS=300

# Calendar / market-hours settings for the local profile. The dev profile
# treats the market as always open so seeding and tests are time-independent.
SWAP_CALENDAR_ENABLED=false
SWAP_CALENDAR_TIMEZONE=UTC
SWAP_CALENDAR_OPEN_HOUR=0
SWAP_CALENDAR_CLOSE_HOUR=24

# Seed tooling flags (see `cargo xtask seed`). Deterministic ids/timestamps
# are derived from SWAP_SEED_EPOCH so local runs and snapshots are comparable.
SWAP_SEED_ENABLED=true
SWAP_SEED_EPOCH=1700000000
SWAP_SEED_TENANTS=2
SWAP_SEED_ASSETS=4
SWAP_SEED_LIQUIDITY_PROVIDERS=3
SWAP_SEED_ORDERS=10
SWAP_SEED_FILLS=10
# Guard: reset/teardown refuses to run unless the target host is local.
SWAP_SEED_ALLOW_RESET=true
SWAP_SEED_ALLOWED_HOSTS=localhost,127.0.0.1,::1,postgres

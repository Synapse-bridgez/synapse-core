{
  "openapi": "3.0.3",
  "info": { "title": "Synapse Swap API", "version": "1.0.0" },
  "paths": {
    "/swap/v1/analytics": {
      "get": {
        "summary": "Tenant-scoped swap analytics buckets",
        "parameters": [
          { "name": "granularity", "in": "query", "required": true },
          { "name": "from", "in": "query", "required": true },
          { "name": "to", "in": "query", "required": true },
          { "name": "pair", "in": "query", "required": false },
          { "name": "direction", "in": "query", "required": false },
          { "name": "status", "in": "query", "required": false },
          { "name": "limit", "in": "query", "required": false },
          { "name": "offset", "in": "query", "required": false }
        ],
        "responses": { "200": {}, "400": {} }
      }
    },
    "/admin/swap/v1/surveillance/findings": { "get": { "responses": { "200": {} } } },
    "/admin/swap/v1/surveillance/findings/{id}/status": { "post": { "responses": { "200": {}, "404": {} } } },
    "/admin/swap/v1/surveillance/findings/{id}/audit": { "get": { "responses": { "200": {} } } },
    "/admin/swap/v1/market-data/quotes": { "get": { "responses": { "200": {} } } },
    "/admin/swap/v1/market-data/prices": { "get": { "responses": { "200": {} } } }
  }
}
